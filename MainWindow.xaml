<Window x:Class="EasyWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="Добавить" FontSize="24" Command="{Binding AddCommand}"/>
            <Button Grid.Row="1" Content="Удалить" FontSize="24" Command="{Binding DeleteCommand}"/>
            <Button Grid.Row="2" Grid.RowSpan="2" Content="Редактировать" FontSize="24" Command="{Binding EditCommmand}"/>
        </Grid>

        <ListBox x:Name="ListPerson" 
                 ItemsSource="{Binding People}"
                 SelectedItem="{Binding SelectedPerson}"
                 DisplayMemberPath="Name"/>
    </Grid>
</Window>
